# Required — inject via Wingman.OS secrets / environment, never commit values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Security ozone layer v0 — HMAC signing key for tunnel state vectors.
# If unset, the service derives from SUPABASE_KEY and logs a dev-fallback warning.
OZONE_HMAC_KEY=generate-with-openssl-rand-hex-32

# Rotation across multiple active credentials (sign with first, verify with all):
# OZONE_HMAC_KEYS=kid-2026-09:AAAA,kid-2026-06:BBBB

# Local LLM ring nodes (Ollama). Optional; compressor works offline without it.
# OLLAMA_URL=http://localhost:11434

# Optional tuning (defaults shown).
# SERVICE_VERSION=1.0.0
# MAX_RETRIES=3
# RETRY_BASE_DELAY_SECONDS=0.25
# UPSTREAM_TIMEOUT_SECONDS=10.0
# RANKINGS_LIMIT=10
